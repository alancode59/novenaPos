FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://posnovena:posnovena@db:5432/posnovena
POSTGRES_DB=posnovena
POSTGRES_USER=posnovena
POSTGRES_PASSWORD=posnovena

# Pepper de contrasenas: secreto de aplicacion usado en HMAC-SHA256 antes
# de hashear con Argon2id (ver app/security/hashing.py). Obligatorio en
# produccion; si se omite en desarrollo se usa un fallback inseguro fijo
# definido en el codigo (NUNCA usar ese fallback fuera de dev local).
PASSWORD_PEPPER=change-me-too-a-long-random-secret

# Las cookies de sesion son Secure (HTTPS-only) por defecto en todo
# ambiente. Solo para correr en local sin TLS (http://localhost) definir
# FORCE_INSECURE_COOKIES=1. NUNCA activarlo en produccion.
FORCE_INSECURE_COOKIES=1
